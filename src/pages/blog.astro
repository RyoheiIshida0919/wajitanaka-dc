---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterCTA from '../components/StickyFooterCTA.astro';
---

<BaseLayout
  title="ブログ｜和地たなか歯科"
  description="和地たなか歯科のブログ。診療案内・症例紹介・お口の健康情報などを発信しています。"
>
  <Header />
  <main id="main-content">
    <!-- Page Hero -->
    <div class="page-hero">
      <img src="/images/site/hero-1.jpg" alt="和地たなか歯科" class="page-hero__img" />
      <div class="page-hero__overlay">
        <h1 class="page-hero__title">ブログ</h1>
      </div>
    </div>

    <section class="blog-section">
      <div class="container">
        <p class="blog-intro">診療案内・症例紹介・お口の健康情報などを発信しています。</p>

        <!-- note embed -->
        <div class="note-embed">
          <script src="https://note.com/scripts/embed.js" type="text/javascript" async></script>
          <div id="note-embed-container">
            <iframe
              src="https://note.com/wajitanaka_dc/embed"
              style="border: 0; display: block; max-width: 99%; width: 500px; padding: 0px; margin: 10px auto; position: static; visibility: visible;"
              height="400"
              loading="lazy"
              title="和地たなか歯科 note"
            ></iframe>
          </div>
          <!-- Fallback link -->
          <div class="note-link">
            <p>ブログ（note）はこちらからもご覧いただけます。</p>
            <a href="https://note.com/wajitanaka_dc" target="_blank" rel="noopener noreferrer" class="btn">
              noteを見る
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <StickyFooterCTA />
</BaseLayout>

<style>
.page-hero {
  position: relative;
  height: 320px;
  overflow: hidden;
}
.page-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: flex-end;
  padding: 40px 48px;
}
.page-hero__title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.05em;
}
.blog-section {
  padding: 64px 0 80px;
  background: #fff;
}
.blog-intro {
  text-align: center;
  color: #555;
  font-size: 1rem;
  margin-bottom: 48px;
}
.note-embed {
  max-width: 860px;
  margin: 0 auto;
}
.note-link {
  text-align: center;
  margin-top: 32px;
}
.note-link p {
  color: #666;
  margin-bottom: 16px;
  font-size: 0.95rem;
}
@media (max-width: 640px) {
  .page-hero { height: 220px; }
  .page-hero__overlay { padding: 24px; }
}
</style>
