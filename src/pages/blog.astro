---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterCTA from '../components/StickyFooterCTA.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { loadPage } from '../lib/pages';

// 中身は EmDash の「ページ」→「blog」で編集する。未登録なら下の既定の並びで表示
const page = await loadPage("blog");
const fallback = [{"_type": "page_hero"}, {"_type": "blog"}];
const defaults = {"page_hero": {"title": "ブログ", "image": "/images/site/blog-hero.jpg", "alt": "院内に飾られた和地たなか歯科のイラスト", "position": "center 48%"}};
const layout = page?.layout.length ? page.layout : fallback;
const title = page?.seoTitle || "ブログ｜和地たなか歯科";
const description = page?.seoDescription || "和地たなか歯科のブログ。診療案内、症例紹介、お口の健康情報などをnoteで発信しています。";
---

<BaseLayout title={title} description={description}
  ogImage="/images/site/blog-hero.jpg">
  <Header />
  <main id="main-content">
    <PageBlocks layout={layout} defaults={defaults} />
  </main>
  <Footer />
  <StickyFooterCTA />
</BaseLayout>
