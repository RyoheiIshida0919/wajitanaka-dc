---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterCTA from '../components/StickyFooterCTA.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { loadPage } from '../lib/pages';

// 中身は EmDash の「ページ」→「features」で編集する。未登録なら下の既定の並びで表示
const page = await loadPage("features");
const fallback = [{"_type": "page_hero"}, {"_type": "features"}];
const defaults = {"page_hero": {"title": "当院の特徴", "image": "/images/site/doctors-hero.jpg", "alt": "和地たなか歯科の院内", "position": "center 52%"}};
const layout = page?.layout.length ? page.layout : fallback;
const title = page?.seoTitle || "当院の特徴｜和地たなか歯科";
const description = page?.seoDescription || "和地たなか歯科の特徴をご紹介します。0歳から通える歯科医院、歯をできるだけ残す治療、静脈内鎮静法、託児、Web予約、予防・管理の6つです。";
---

<BaseLayout title={title} description={description}
  ogImage="/images/site/doctors-hero.jpg">
  <Header />
  <main id="main-content">
    <PageBlocks layout={layout} defaults={defaults} />
  </main>
  <Footer />
  <StickyFooterCTA />
</BaseLayout>
