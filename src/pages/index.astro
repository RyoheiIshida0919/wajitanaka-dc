---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterCTA from '../components/StickyFooterCTA.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { loadPage } from '../lib/pages';

// 中身は EmDash の「ページ」→「home」で編集する。未登録なら下の既定の並びで表示
const page = await loadPage("home");
const fallback = [{"_type": "hero_slider"}, {"_type": "message"}, {"_type": "features"}, {"_type": "treatments"}, {"_type": "access"}, {"_type": "news"}];
const defaults = {};
const layout = page?.layout.length ? page.layout : fallback;
const title = page?.seoTitle || "和地たなか歯科｜浜松市中央区・和地町 0歳から100歳まで通える歯科医院";
const description = page?.seoDescription || "ここから笑顔が生まれる。歯も、心も。浜松市中央区和地町の和地たなか歯科。0歳から100歳まで通える歯科医院。保育士による無料託児・女性歯科医師在籍・静脈内鎮静法対応。TEL: 053-489-8185";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <PageBlocks layout={layout} defaults={defaults} />
  </main>
  <Footer />
  <StickyFooterCTA />
</BaseLayout>
