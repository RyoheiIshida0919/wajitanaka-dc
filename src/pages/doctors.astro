---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterCTA from '../components/StickyFooterCTA.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { loadPage } from '../lib/pages';

// 中身は EmDash の「ページ」→「doctors」で編集する。未登録なら下の既定の並びで表示
const page = await loadPage("doctors");
const fallback = [{"_type": "page_hero"}, {"_type": "doctors"}];
const defaults = {"page_hero": {"title": "医師紹介", "image": "/images/site/doctors-hero.jpg", "alt": "和地たなか歯科の院内", "position": "center 52%"}};
const layout = page?.layout.length ? page.layout : fallback;
const title = page?.seoTitle || "医師紹介｜和地たなか歯科";
const description = page?.seoDescription || "和地たなか歯科の院長 田中亮次、医師 田中有美の診療への想い、経歴、得意な治療をご紹介します。";
---

<BaseLayout title={title} description={description}
  ogImage="/images/site/doctors-hero.jpg">
  <Header />
  <main id="main-content">
    <PageBlocks layout={layout} defaults={defaults} />
  </main>
  <Footer />
  <StickyFooterCTA />
</BaseLayout>
