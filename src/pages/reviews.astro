---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterCTA from '../components/StickyFooterCTA.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { loadPage } from '../lib/pages';

// 中身は EmDash の「ページ」→「reviews」で編集する。未登録なら下の既定の並びで表示
const page = await loadPage("reviews");
const fallback = [{"_type": "page_hero"}, {"_type": "commitments"}, {"_type": "faq"}];
const defaults = {"page_hero": {"title": "こだわりとQ&A", "image": "/images/site/reviews-hero.jpg", "alt": "院内の照明と木の天井", "position": "center 45%"}};
const layout = page?.layout.length ? page.layout : fallback;
const title = page?.seoTitle || "こだわりとQ&A｜和地たなか歯科";
const description = page?.seoDescription || "和地たなか歯科が大切にしている6つのこだわりと、患者さんからよくいただくご質問をご紹介します。";
---

<BaseLayout title={title} description={description}
  ogImage="/images/site/reviews-hero.jpg">
  <Header />
  <main id="main-content">
    <PageBlocks layout={layout} defaults={defaults} />
  </main>
  <Footer />
  <StickyFooterCTA />
</BaseLayout>
