---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import PageBlocks from '../components/PageBlocks.astro';
import { loadPage } from '../lib/pages';

// 中身は EmDash の「ページ」→「privacy-policy」で編集する。未登録なら下の既定の並びで表示
const page = await loadPage("privacy-policy");
const fallback = [{"_type": "simple_page"}];
const defaults = {"simple_page": {"title": "プライバシーポリシー", "body": "個人情報の取り扱いについては、法令に従い適切に管理します。"}};
const layout = page?.layout.length ? page.layout : fallback;
const title = page?.seoTitle || "プライバシーポリシー｜和地たなか歯科";
const description = page?.seoDescription || "和地たなか歯科のプライバシーポリシー。";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <PageBlocks layout={layout} defaults={defaults} />
  </main>
  <Footer />

</BaseLayout>
