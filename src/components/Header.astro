---
const reserveUrl = 'https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae';
const questionnaireUrl = 'https://forms.gle/7NgJVgftCjhT28Do6';
const navItems = [
  { label: 'ホーム', href: '/' },
  { label: '当院の特徴', href: '/#features' },
  { label: '診療案内', href: '/#treatments' },
  { label: '医師紹介', href: '/doctors' },
  { label: 'アクセス', href: '/#access' },
  { label: 'ブログ', href: '/blog' },
  { label: 'こだわりとQ&A', href: '/reviews' },
];
---

<header id="site-header" class="header">
  <div class="header__inner">
    <a class="header__brand" href="/" aria-label="和地たなか歯科 トップページ">
      <img class="header__logo-image" src="/images/site/logo.png" alt="和地たなか歯科" width="360" height="90" />
    </a>

    <nav class="header__nav" aria-label="メインナビゲーション">
      <ul>
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__action header__action--outline" href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
      <a class="header__action header__action--fill" href={questionnaireUrl} target="_blank" rel="noopener noreferrer">初診予約後<br />web問診</a>
    </div>

    <button class="header__menu" id="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false">
      <span></span><span></span><span></span>
      <span class="sr-only">メニューを開く</span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <button class="mobile-menu__backdrop" type="button" aria-label="メニューを閉じる"></button>
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="メニュー">
    <div class="mobile-menu__head">
      <img src="/images/site/logo.png" alt="和地たなか歯科" width="342" height="149" />
      <button class="mobile-menu__close" id="menu-close" type="button" aria-label="メニューを閉じる">×</button>
    </div>
    <nav aria-label="モバイルナビゲーション">
      <ul>
        {navItems.map((item) => <li><a class="mobile-menu__link" href={item.href}>{item.label}<span>→</span></a></li>)}
      </ul>
    </nav>
    <div class="mobile-menu__actions">
      <a href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
      <a href={questionnaireUrl} target="_blank" rel="noopener noreferrer">初診予約後 web問診</a>
    </div>
  </div>
</div>

<style>
  .header {
    position: relative;
    z-index: 100;
    height: 90px;
    border-bottom: 1px solid #e8e8e8;
    background: #fff;
    font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Meiryo", sans-serif;
  }

  .header__inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px 0 24px;
  }

  .header__brand {
    flex: 0 0 auto;
  }

  .header__logo-image {
    display: block;
    width: 180px;
    height: auto;
  }

  .header__nav {
    display: flex;
    flex: 1;
    justify-content: center;
    padding: 0 20px;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .header__nav a {
    position: relative;
    display: block;
    color: #333;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .header__nav a::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    background: var(--green);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .header__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__actions {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }

  .header__action {
    display: flex;
    width: 110px;
    height: 68px;
    align-items: center;
    justify-content: center;
    background: #3d7a5e;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    letter-spacing: 0.05em;
    transition: background-color 180ms ease, color 180ms ease;
    white-space: nowrap;
  }

  .header__action--outline:hover {
    background: #2f6049;
  }

  .header__action--fill:hover {
    background: #2f6049;
  }

  .header__menu {
    display: none;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    margin-left: auto;
    background: var(--green);
  }

  .header__menu span:not(.sr-only) {
    width: 22px;
    height: 1px;
    background: #fff;
  }

  .mobile-menu {
    position: fixed;
    z-index: 300;
    inset: 0;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(17, 32, 27, 0.42);
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(86vw, 390px);
    height: 100%;
    overflow-y: auto;
    background: #fff;
  }

  .mobile-menu__head {
    display: flex;
    height: 86px;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu__head img {
    width: 150px;
  }

  .mobile-menu__close {
    width: 42px;
    height: 42px;
    color: var(--green);
    font-size: 2rem;
    font-weight: 300;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .mobile-menu__link span {
    color: var(--green);
  }

  .mobile-menu__actions {
    display: grid;
    gap: 10px;
    padding: 24px 22px;
  }

  .mobile-menu__actions a {
    padding: 13px;
    background: var(--green);
    color: #fff;
    text-align: center;
  }

  @media (max-width: 1180px) {
    .header {
      height: auto;
    }

    .header__inner {
      height: auto;
      padding: 28px;
      align-items: center;
    }

    .header__brand {
      display: block;
    }

    .header__nav,
    .header__actions {
      display: none;
    }

    .header__menu {
      display: flex;
      width: 72px;
      height: 72px;
      margin-left: auto;
    }
  }

  @media (max-width: 640px) {
    .header__inner {
      padding: 18px 16px 18px 14px;
    }

    .header__logo-image {
      width: 160px;
    }

    .header__menu {
      width: 56px;
      height: 56px;
    }

    .header__menu span:not(.sr-only) {
      width: 20px;
    }
  }
</style>

<script>
  const menu = document.getElementById('mobile-menu');
  const toggle = document.getElementById('menu-toggle');
  const closeButton = document.getElementById('menu-close');
  const backdrop = menu?.querySelector('.mobile-menu__backdrop');

  const openMenu = () => {
    menu?.removeAttribute('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
  };

  const closeMenu = () => {
    menu?.setAttribute('hidden', '');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  };

  toggle?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('.mobile-menu__link').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
