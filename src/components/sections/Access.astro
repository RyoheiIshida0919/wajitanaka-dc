---
const reserveUrl = 'https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae';
const routes = [
  { label: 'お車', text: '無料駐車場21台（うち車椅子用駐車場1台）' },
  { label: 'バス', text: '遠鉄バス すじかい橋バス停から徒歩2分' },
  { label: '電車', text: '天竜浜名湖線 気賀駅からタクシーで13分' },
  { label: '高速', text: '舘山寺ICまたは浜松西ICから車で約8分' },
];
---

<section class="access" id="access">
  <div class="container access__layout">
    <h2 class="section-marker section-marker--vertical">アクセス</h2>
    <div class="access__content">
      <div class="access__map reveal">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3277.7178222443677!2d137.6561499755925!3d34.76270037289769!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x601b270ea81de745%3A0xc76024dc9e1f5fbd!2z5ZKM5Zyw44Gf44Gq44GL5q2v56eR!5e0!3m2!1sja!2sjp!4v1743118175364!5m2!1sja!2sjp"
          width="100%"
          height="520"
          style="border:0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="和地たなか歯科への地図"
        ></iframe>
      </div>
      <div class="access__routes">
        {routes.map((route) => (
          <div class="access__route reveal">
            <span>{route.label}</span>
            <p>{route.text}</p>
          </div>
        ))}
      </div>
      <div class="access__reserve reveal">
        <a class="reserve-link" href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
      </div>
    </div>
  </div>
</section>

<style>
  .access {
    padding-block: var(--section-space);
    background: #fff;
  }

  .access__layout {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: clamp(40px, 7vw, 100px);
    align-items: start;
  }

  .access__layout > .section-marker {
    position: sticky;
    top: 125px;
    justify-self: center;
  }

  .access__map {
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .access__map iframe {
    display: block;
    width: 100%;
    filter: saturate(0.76) contrast(0.96);
  }

  .access__routes {
    display: grid;
    margin-top: clamp(35px, 5vw, 65px);
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .access__route {
    display: grid;
    min-height: 112px;
    grid-template-columns: 74px 1fr;
    align-items: center;
    padding: 20px 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .access__route span {
    color: var(--green);
    font-size: 0.83rem;
    font-weight: 500;
  }

  .access__route p {
    font-size: 0.76rem;
    line-height: 1.8;
  }

  .access__reserve {
    margin-top: 50px;
    text-align: center;
  }

  @media (max-width: 767px) {
    .access__layout {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .access__layout > .section-marker {
      position: static;
      justify-self: start;
    }

    .access__map iframe {
      height: 380px;
    }

    .access__routes {
      grid-template-columns: 1fr;
    }

    .access__route {
      grid-template-columns: 58px 1fr;
      padding-inline: 18px;
    }
  }
</style>
