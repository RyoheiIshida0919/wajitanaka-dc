---
const reserveUrl = 'https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae';
const routes = [
  { label: 'お車', text: '無料駐車場21台（うち車椅子用駐車場1台）' },
  { label: 'バス', text: '遠鉄バス すじかい橋バス停から徒歩2分' },
  { label: '電車', text: '天竜浜名湖線 気賀駅からタクシーで13分' },
  { label: '高速', text: '舘山寺ICまたは浜松西ICから車で約8分' },
];
---

<section class="access" id="access">
  <div class="access__layout">
    <h2 class="access__side-title">アクセス</h2>
    <div class="access__content">
      <div class="access__map reveal">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3277.7178222443677!2d137.6561499755925!3d34.76270037289769!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x601b270ea81de745%3A0xc76024dc9e1f5fbd!2z5ZKM5Zyw44Gf44Gq44GL5q2v56eR!5e0!3m2!1sja!2sjp!4v1743118175364!5m2!1sja!2sjp"
          width="100%"
          height="520"
          style="border:0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="和地たなか歯科への地図"
        ></iframe>
      </div>
      <div class="access__info reveal">
        {routes.map((route) => (
          <p><span>{route.label}でお越しの方：</span>{route.text}</p>
        ))}
      </div>
      <div class="access__reserve reveal">
        <a class="reserve-link" href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
      </div>
    </div>
  </div>
</section>

<style>
  .access {
    padding: clamp(60px, 8vw, 96px) 0;
    background: #fff;
  }

  .access__layout {
    width: min(960px, calc(100% - 80px));
    margin: 0 auto;
    padding: 0 40px;
  }

  .access__content {
    width: 100%;
  }

  .access__content::before {
    content: "";
    display: table;
  }

  .access__side-title {
    float: left;
    margin: 0;
    margin-right: 28px;
    padding-top: 4px;
    padding-right: 18px;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    align-self: flex-start;
    border-right: 2px solid #222;
    color: #222;
    font-family: "Yu Gothic Medium", "Yu Gothic", "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .access__map {
    margin-bottom: 50px;
    height: 460px;
    overflow: hidden;
  }

  .access__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    filter: saturate(0.76) contrast(0.96);
  }

  .access__info {
    text-align: center;
    margin-bottom: 40px;
  }

  .access__info p {
    margin: 0;
    color: #333;
    font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Meiryo", sans-serif;
    font-size: 0.875rem;
    line-height: 2;
    letter-spacing: 0.02em;
  }

  .access__reserve {
    text-align: center;
  }

  .access__reserve .reserve-link {
    min-width: 0;
    min-height: 0;
    padding: 18px 80px;
    border: none;
    border-radius: 0;
    background: #3d7a5e;
    color: #fff;
    font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Meiryo", sans-serif;
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0.2em;
  }

  .access__reserve .reserve-link::after {
    display: none;
  }

  .access__reserve .reserve-link:hover {
    background: #2f6049;
  }

  @media (max-width: 900px) {
    .access__layout {
      width: min(92%, 960px);
      padding: 0;
    }

    .access__map {
      height: 300px;
    }

    .access__info {
      text-align: left;
    }

    .access__info p {
      font-size: 0.875rem;
    }

    .access__reserve .reserve-link {
      width: 100%;
      padding-inline: 24px;
    }
  }

  @media (max-width: 767px) {
    .access__layout {
      width: min(100% - 32px, 640px);
    }

    .access__side-title {
      float: none;
      width: auto;
      writing-mode: horizontal-tb;
      margin-right: 0;
      margin-bottom: 24px;
      padding-top: 0;
      padding-right: 0;
      padding-bottom: 10px;
      border-right: 0;
      border-bottom: 2px solid #333;
      font-size: 1rem;
      letter-spacing: 0.1em;
      line-height: 1.2;
    }
  }
</style>
