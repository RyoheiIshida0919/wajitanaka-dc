---
const reserveUrl = 'https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae';
const features = [
  {
    id: '01',
    title: '0歳から100歳まで通える歯科医院',
    text: 'お口の健康は赤ちゃんの頃から大切です。当院では0歳からの口腔ケアを推奨し、生涯にわたってサポートします。また、噛む力は、健康寿命に大きく影響します。食べる楽しみを守り、ずっとご自身の歯で過ごせるようにお手伝いします。院内はバリアフリー設計です。',
    images: ['/images/site/child-f01.jpg', '/images/site/f01-2.jpg'],
  },
  {
    id: '02',
    title: '歯をできるだけ残す治療',
    text: 'むし歯や歯周病で失われた歯を補うことも大切ですが、そもそも「抜かずに済む選択肢」を最大限考えることが、患者さんの未来の健康につながると考えています。ご自身の歯の移植も積極的に行っています。',
    images: ['/images/site/f02-1.jpg', '/images/site/f02-2.jpg'],
  },
  {
    id: '03',
    title: 'リラックス歯科・静脈内鎮静法対応',
    text: '歯科治療が怖い、過去の経験から不安がある。そんな方でも通える歯科医院へ。個室診療室があり、リラックスした状態で治療を受けられる静脈内鎮静法を導入しています。',
    images: ['/images/site/f03-1.jpg', '/images/site/f03-2.jpg'],
  },
  {
    id: '04',
    title: '女性歯科医師在籍・保育士による託児',
    text: '女性ならではの視点で、お子さまや歯科が苦手な方にも安心して通院いただける環境を整えています。保育士による無料託児があり、小さなお子様がいても安心して通院できます。',
    images: ['/images/site/f04-1.jpg', '/images/site/f04-2.jpg'],
  },
  {
    id: '05',
    title: 'Web予約・アプリ予約が可能',
    text: '忙しい方でも簡単に予約できるよう、Web予約・アプリ予約に対応しています。アプリでご自身のお口の中の管理ができます。',
    images: ['/images/site/f05-1.jpg', '/images/site/f05-2.jpg'],
  },
  {
    id: '06',
    title: '予防・管理を重視した歯科診療',
    text: '治療だけでなく、患者さん自身が自分の口に興味を持ち、主体的にケアできるようサポートします。悪くなったから治すのではなく、なぜ悪くなったかに注目し、再発を防ぎます。',
    images: ['/images/site/f06-1.jpg', '/images/site/f06-2.jpg'],
  },
];
---

<section class="features" id="features">
  <div class="container features__layout">
    <h2 class="section-marker section-marker--vertical">当院の特徴</h2>
    <div class="features__list">
      {features.map((feature) => (
        <article class="feature reveal">
          <div class="feature__copy">
            <span class="section-number">{feature.id}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </div>
          <div class="feature__images">
            {feature.images.map((image, index) => (
              <img src={image} alt={index === 0 ? feature.title : ''} loading="lazy" />
            ))}
          </div>
        </article>
      ))}
      <div class="features__reserve reveal">
        <a class="reserve-link" href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--section-space);
    background: #fff;
  }

  .features__layout {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: clamp(40px, 7vw, 100px);
    align-items: start;
  }

  .features__layout > .section-marker {
    position: sticky;
    top: 125px;
    justify-self: center;
  }

  .features__list {
    max-width: 930px;
  }

  .feature {
    padding-bottom: clamp(76px, 10vw, 145px);
  }

  .feature__copy {
    max-width: 680px;
    margin: 0 auto clamp(30px, 4vw, 55px);
  }

  .feature__copy h3 {
    margin-block: 15px 20px;
    color: var(--green);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.11em;
  }

  .feature__copy p {
    font-size: clamp(0.85rem, 1.05vw, 0.96rem);
    line-height: 2.15;
  }

  .feature__images {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(10px, 1.7vw, 24px);
  }

  .feature__images img {
    width: 100%;
    aspect-ratio: 1.55 / 1;
    object-fit: cover;
  }

  .features__reserve {
    text-align: center;
  }

  @media (max-width: 767px) {
    .features__layout {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .features__layout > .section-marker {
      position: static;
      justify-self: start;
    }

    .feature {
      padding-bottom: 82px;
    }

    .feature__images {
      gap: 8px;
    }

    .feature__images img {
      aspect-ratio: 1 / 0.82;
    }
  }
</style>
