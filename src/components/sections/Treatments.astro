---

<section class="treatments" id="treatments">
  <div class="treatments-header">
    <div class="container">
      <h2 class="treatments-title">診療案内</h2>
    </div>
  </div>
  <div class="treatments-body">
    <div class="container">
      <ul class="treatments-grid reveal">
        {treatments.map(item => (
          <li class="treatment-item">
            <a href={item.href} class="treatment-link" aria-label={`${item.name}について詳しく見る`}>
              <div class="treatment-icon" set:html={item.icon} />
              <p class="treatment-name">{item.name}</p>
              <p class="treatment-sub">{item.sub}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
.treatments-header {
  background-color: var(--color-primary, #018966);
  padding: 2rem 0;
  text-align: center;
}
.treatments-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.1em;
}
.treatments-body {
  background-color: #f5f5f5;
  padding: 3rem 0;
}
.treatments-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem 1rem;
  list-style: none;
  padding: 0;
  margin: 0;
}
.treatment-item {
  display: flex;
}
.treatment-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: opacity 0.2s;
  width: 100%;
}
.treatment-link:hover {
  opacity: 0.8;
}
.treatment-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  margin-bottom: 0.5rem;
}
.treatment-icon svg {
  width: 64px;
  height: 64px;
}
.treatment-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: #222;
  text-align: center;
  letter-spacing: 0.03em;
  line-height: 1.4;
}
.treatment-sub {
  font-size: 0.7rem;
  color: #666;
  text-align: center;
  margin-top: 0.2rem;
  letter-spacing: 0.01em;
  line-height: 1.4;
}
@media (min-width: 640px) {
  .treatment-icon { width: 96px; height: 96px; }
  .treatment-icon svg { width: 80px; height: 80px; }
  .treatment-name { font-size: 1rem; }
  .treatment-sub { font-size: 0.75rem; }
}
</style>
