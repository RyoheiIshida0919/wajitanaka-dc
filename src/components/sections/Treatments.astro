---
const treatments = [
  { name: '一般歯科', sub: 'むし歯・歯周病・知覚過敏', icon: '/images/site/icon-general.png' },
  { name: '小児歯科', sub: 'むし歯・歯みがき・歯並び', icon: '/images/site/icon-child.png' },
  { name: '予防歯科', sub: 'メンテナンス・定期検診', icon: '/images/site/icon-prevent.png' },
  { name: '歯科恐怖外来', sub: '静脈内鎮静法・リラックス歯科', icon: '/images/site/icon-fear.png' },
  { name: 'ホワイトニング', sub: '審美歯科・白いかぶせ物', icon: '/images/site/icon-whitening.png' },
  { name: 'インプラント', sub: '失った歯を補う治療', icon: '/images/site/icon-implant.png' },
  { name: '歯並び', sub: '矯正相談', icon: '/images/site/icon-ortho.png' },
  { name: '顎関節症', sub: '歯ぎしり・くいしばり', icon: '/images/site/icon-tmj.png' },
  { name: '口腔外科', sub: '親知らず・口内炎・粘膜の異常', icon: '/images/site/icon-oral.png' },
];
---

<section class="treatments" id="treatments">
  <div class="container treatments__layout">
    <h2 class="treatments__side-title">診療案内</h2>
    <div class="treatments__content">
      <ul class="treatments-grid">
        {treatments.map((item) => (
          <li class="treatment-item reveal">
            <div class="treatment-icon">
              <img src={item.icon} alt="" loading="lazy" />
            </div>
            <h3 class="treatment-name">{item.name}</h3>
            <p class="treatment-sub">{item.sub}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .treatments {
    padding-block: var(--section-space);
    background: #fff;
  }

  .treatments__layout {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: clamp(40px, 7vw, 100px);
    align-items: start;
  }

  .treatments__side-title {
    position: sticky;
    top: 125px;
    margin: 0;
    justify-self: center;
    padding-top: 8px;
    padding-right: 18px;
    border-right: 2px solid #222;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    color: #222;
    font-family: "Yu Gothic Medium", "Yu Gothic", "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.2;
    min-height: 172px;
    white-space: nowrap;
  }

  .treatments__content {
    min-width: 0;
  }

  .treatments-grid {
    display: grid;
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
    padding: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(16px, 3vw, 48px);
    row-gap: clamp(56px, 7vw, 96px);
    list-style: none;
  }

  .treatment-item {
    display: flex;
    min-width: 0;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .treatment-icon {
    display: flex;
    height: clamp(84px, 10vw, 120px);
    align-items: center;
    justify-content: center;
    margin-bottom: clamp(14px, 2vw, 22px);
  }

  .treatment-icon img {
    max-width: clamp(100px, 12vw, 150px);
    max-height: 100%;
    width: auto;
    height: auto;
  }

  .treatment-name {
    margin: 0;
    color: #10896a;
    font-family: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Noto Sans JP", sans-serif;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .treatment-sub {
    margin: 7px 0 0;
    color: #10896a;
    font-family: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Noto Sans JP", sans-serif;
    font-size: clamp(0.68rem, 1vw, 0.78rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.55;
  }

  @media (max-width: 767px) {
    .treatments__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 45px;
    }

    .treatments__side-title {
      position: static;
      justify-self: start;
      writing-mode: horizontal-tb;
      margin-right: 0;
      padding-top: 0;
      padding-right: 0;
      padding-bottom: 12px;
      border-right: 0;
      border-bottom: 2px solid #222;
      font-size: 1.05rem;
      letter-spacing: 0.12em;
      min-height: 0;
    }

    .treatments-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 12px;
      row-gap: 44px;
    }

    .treatment-item:last-child {
      grid-column: span 2;
    }

    .treatment-icon {
      height: 76px;
      margin-bottom: 12px;
    }

    .treatment-icon img {
      max-width: 96px;
    }

    .treatment-name {
      font-size: 1.02rem;
    }

    .treatment-sub {
      font-size: 0.68rem;
    }
  }
</style>
