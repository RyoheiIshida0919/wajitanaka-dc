---
---
<section class="instagram reveal">
  <div class="container">
    <div class="section-header">
      <span class="section-en">INSTAGRAM</span>
      <h2 class="section-title">インスタグラム</h2>
      <p class="instagram-handle">
        <a href="https://www.instagram.com/wajitanaka_dc/" target="_blank" rel="noopener noreferrer">
          @wajitanaka_dc
        </a>
      </p>
    </div>
    <div class="instagram-grid" id="instagram-grid">
      <!-- Instagram posts will be loaded here -->
      <div class="instagram-placeholder">
        <p>インスタグラムの最新投稿はこちらから</p>
        <a href="https://www.instagram.com/wajitanaka_dc/" target="_blank" rel="noopener noreferrer" class="btn">
          インスタグラムを見る
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.instagram {
  padding: 80px 0;
  background: #fff;
}
.section-header {
  text-align: center;
  margin-bottom: 40px;
}
.section-en {
  display: block;
  font-size: 13px;
  letter-spacing: 0.2em;
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: 8px;
}
.section-title {
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8px;
}
.instagram-handle a {
  color: var(--color-primary);
  font-size: 1rem;
  text-decoration: none;
  font-weight: 500;
}
.instagram-handle a:hover {
  text-decoration: underline;
}
.instagram-placeholder {
  text-align: center;
  padding: 60px 20px;
  background: #f8faf8;
  border-radius: 12px;
  border: 2px dashed #cce5dc;
}
.instagram-placeholder p {
  color: #666;
  margin-bottom: 20px;
  font-size: 1rem;
}
</style>
