---
---
<section class="instagram reveal">
  <div class="container">
    <div class="section-header">
      <span class="section-en">INSTAGRAM</span>
      <h2 class="section-title">インスタグラム</h2>
      <p class="instagram-handle">
        <a href="https://www.instagram.com/wajitanakadc/" target="_blank" rel="noopener noreferrer">
          @wajitanakadc
        </a>
      </p>
    </div>
    <div class="instagram-feed">
      <!-- Instagram embed via Elfsight or direct embed -->
      <div class="instagram-embed-wrap">
        <blockquote
          class="instagram-media"
          data-instgrm-permalink="https://www.instagram.com/wajitanakadc/"
          data-instgrm-version="14"
          style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px; max-width:100%; min-width:326px; padding:0; width:99.375%;"
        ></blockquote>
      </div>
      <script async src="//www.instagram.com/embed.js"></script>
      <div class="instagram-cta">
        <a href="https://www.instagram.com/wajitanakadc/" target="_blank" rel="noopener noreferrer" class="btn">
          インスタグラムをフォローする
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.instagram {
  padding: 80px 0;
  background: #fff;
}
.section-header {
  text-align: center;
  margin-bottom: 40px;
}
.section-en {
  display: block;
  font-size: 13px;
  letter-spacing: 0.2em;
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: 8px;
}
.section-title {
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8px;
}
.instagram-handle a {
  color: var(--color-primary);
  font-size: 1rem;
  text-decoration: none;
  font-weight: 500;
}
.instagram-handle a:hover {
  text-decoration: underline;
}
.instagram-feed {
  max-width: 540px;
  margin: 0 auto;
}
.instagram-embed-wrap {
  margin-bottom: 24px;
}
.instagram-cta {
  text-align: center;
}
</style>
