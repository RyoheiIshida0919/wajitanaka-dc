---
---

<section class="catch" aria-label="キャッチコピー">
  <div class="catch__inner container">
    <img
      class="catch__mark"
      src="/images/site/logo-mark.png"
      alt=""
      width="87"
      height="83"
      aria-hidden="true"
    />
    <h2 class="catch__headline">ここから笑顔がうまれる。<br />歯も、心も。</h2>
  </div>
</section>

<style>
  .catch {
    background-color: #fff;
    padding-block: clamp(38px, 6vw, 72px) clamp(26px, 4vw, 44px);
    text-align: center;
  }

  .catch__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .catch__mark {
    width: clamp(92px, 11vw, 118px);
    height: auto;
    margin-bottom: clamp(14px, 2vw, 22px);
  }

  .catch__headline {
    color: #018966;
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Hiragino Mincho Pro", serif;
    font-size: clamp(1.45rem, 3.2vw, 2.05rem);
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.1em;
  }

  @media (max-width: 600px) {
    .catch__headline {
      letter-spacing: 0.06em;
    }
  }
</style>
