---
const slides = [
  { src: '/images/site/hero-1.jpg', alt: '和地たなか歯科 外観', text: '0才から100才まで\nみんなが通える歯医者さん' },
  { src: '/images/site/hero-2.jpg', alt: '和地たなか歯科 院内待合室', text: 'みんなにやさしい\nバリアフリー設計' },
  { src: '/images/site/hero-3.jpg', alt: '女性歯科医師がいて小さなお子様も安心', text: '女性歯科医師がいて\n小さなお子様も安心' },
];
---
<section class="hero" id="top" aria-label="トップビジュアル">
  <div class="hero__slider" aria-hidden="true">
    <div class="hero__track" id="heroTrack">
      {slides.map((s, i) => (
        <div class="hero__slide" data-index={i}>
          <img src={s.src} alt={s.alt} class="hero__slide-img" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="hero__slide-overlay"></div>
          <p class="hero__slide-text">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="hero__dots" role="tablist" aria-label="スライド選択">
    {slides.map((_, i) => (
      <button class={`hero__dot${i === 0 ? ' is-active' : ''}`} role="tab" aria-label={`スライド ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} data-dot={i}></button>
    ))}
  </div>
</section>
<style>
  .hero { position: relative; height: 480px; overflow: hidden; background-color: #111; }
  @media (min-width: 768px) { .hero { height: 680px; } }
  .hero__slider { position: absolute; inset: 0; }
  .hero__track { display: flex; height: 100%; transition: transform 0.7s cubic-bezier(0.58,0.21,0.41,0.96); }
  .hero__slide { flex: 0 0 100%; height: 100%; position: relative; }
  .hero__slide-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero__slide-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.1) 100%); pointer-events: none; }
  .hero__slide-text { position: absolute; left: 40px; bottom: 60px; color: #fff; font-size: 1.5rem; font-weight: 700; line-height: 1.5; letter-spacing: 0.04em; text-shadow: 0 2px 8px rgba(0,0,0,0.4); white-space: pre-line; }
  @media (min-width: 768px) { .hero__slide-text { left: 60px; bottom: 80px; font-size: 2.25rem; } }
  @media (max-width: 480px) { .hero__slide-text { left: 20px; bottom: 50px; font-size: 1.25rem; } }
  .hero__dots { position: absolute; bottom: 20px; right: 24px; z-index: 2; display: flex; gap: 8px; }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background-color: rgba(255,255,255,0.45); border: none; cursor: pointer; transition: background-color 0.3s, transform 0.3s; padding: 0; }
  .hero__dot.is-active { background-color: rgba(255,255,255,0.95); transform: scale(1.3); }
</style>
<script>
  const track = document.getElementById('heroTrack') as HTMLElement;
  const dots = document.querySelectorAll<HTMLButtonElement>('.hero__dot');
  const total = 3;
  let current = 0;
  let timer: ReturnType<typeof setInterval>;
  const goTo = (n: number) => {
    current = (n + total) % total;
    if (track) track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => { d.classList.toggle('is-active', i === current); d.setAttribute('aria-selected', String(i === current)); });
  };
  const startTimer = () => { clearInterval(timer); timer = setInterval(() => goTo(current + 1), 5000); };
  dots.forEach((d) => d.addEventListener('click', () => { goTo(Number(d.dataset.dot)); startTimer(); }));
  const heroEl = document.querySelector('.hero');
  heroEl?.addEventListener('mouseenter', () => clearInterval(timer));
  heroEl?.addEventListener('mouseleave', startTimer);
  startTimer();
</script>
