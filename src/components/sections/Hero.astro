---
const slides = [
  {
    className: 'slide-1',
    src: '/images/site/hero-1.jpg',
    alt: '和地たなか歯科の外観',
    text: '0才から100才まで\nみんなが通える歯医者さん',
  },
  {
    className: 'slide-2',
    src: '/images/site/hero-2.jpg',
    alt: '和地たなか歯科の院内',
    text: 'みんなにやさしい\nバリアフリー設計',
  },
  {
    className: 'slide-3',
    src: '/images/site/hero-3.jpg',
    alt: '女性歯科医がいて小さなお子様も安心できる診療風景',
    text: '女性歯科医がいて\n小さなお子様も安心',
  },
];
---

<section class="hero" aria-label="和地たなか歯科のスライドショー">
  <div class="slideshow">
    <div class="slides-track" id="track">
      {slides.map((slide, index) => (
        <div class={`slide ${slide.className}`}>
          <img src={slide.src} alt={slide.alt} loading={index === 0 ? 'eager' : 'lazy'} />
          <div class="slide-caption">{slide.text}</div>
        </div>
      ))}
    </div>

    <button class="arrow prev" id="prevBtn" type="button" aria-label="前へ">
      <svg viewBox="0 0 18 18"><polyline points="11,3 5,9 11,15" /></svg>
    </button>
    <button class="arrow next" id="nextBtn" type="button" aria-label="次へ">
      <svg viewBox="0 0 18 18"><polyline points="7,3 13,9 7,15" /></svg>
    </button>
  </div>

  <div class="dots" id="dots">
    {slides.map((_, index) => (
      <button class={`dot${index === 0 ? ' active' : ''}`} type="button" data-index={index} aria-label={`スライド${index + 1}へ`}></button>
    ))}
  </div>
</section>

<style>
  .hero {
    background: #fff;
    font-family: "Noto Sans JP", sans-serif;
  }

  .slideshow {
    position: relative;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    overflow: hidden;
    background: #000;
  }

  .slides-track {
    display: flex;
    transition: transform 0.7s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .slide {
    position: relative;
    width: 100%;
    flex-shrink: 0;
  }

  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-caption {
    position: absolute;
    color: #3d7a5e;
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.02em;
    white-space: pre-line;
    text-shadow: 1px 1px 6px rgba(255, 255, 255, 0.7), -1px -1px 6px rgba(255, 255, 255, 0.7);
  }

  .slide-1 .slide-caption {
    top: 7%;
    left: 50%;
    font-size: clamp(18px, 2.8vw, 26px);
    text-align: center;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .slide-2 .slide-caption {
    top: 50%;
    right: 4%;
    font-size: clamp(18px, 2.8vw, 26px);
    text-align: right;
    transform: translateY(-50%);
  }

  .slide-3 .slide-caption {
    bottom: 8%;
    left: 4%;
    font-size: clamp(18px, 2.8vw, 26px);
    text-align: left;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 16px 0 12px;
  }

  .dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #ccc;
    cursor: pointer;
    transition: background 0.3s;
  }

  .dot.active {
    background: #3d7a5e;
  }

  .arrow {
    position: absolute;
    top: 50%;
    z-index: 10;
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.55);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s;
  }

  .arrow:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .arrow.prev {
    left: 12px;
  }

  .arrow.next {
    right: 12px;
  }

  .arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #333;
    stroke-width: 2.2;
  }

  @media (max-width: 768px) {
    .slide-1 .slide-caption,
    .slide-2 .slide-caption,
    .slide-3 .slide-caption {
      font-size: 24px;
    }

    .slide-1 .slide-caption,
    .slide-2 .slide-caption {
      top: 22px;
      right: 24px;
    }

    .slide-1 .slide-caption {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
    }

    .slide-2 .slide-caption {
      transform: translateY(-50%);
    }

    .slide-3 .slide-caption {
      bottom: 24px;
      left: 24px;
    }
  }
</style>

<script>
  const track = document.getElementById('track');
  const dots = document.querySelectorAll('.dot');
  const total = 3;
  let current = 0;
  let timer;

  function goTo(index) {
    current = (index + total) % total;
    if (track) track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
  }

  function next() {
    goTo(current + 1);
  }

  function prev() {
    goTo(current - 1);
  }

  function startAuto() {
    clearInterval(timer);
    timer = setInterval(next, 4500);
  }

  document.getElementById('nextBtn')?.addEventListener('click', () => {
    next();
    startAuto();
  });

  document.getElementById('prevBtn')?.addEventListener('click', () => {
    prev();
    startAuto();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      goTo(Number(dot.getAttribute('data-index')));
      startAuto();
    });
  });

  startAuto();
</script>
