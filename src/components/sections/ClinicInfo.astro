<section class="clinic-info reveal">
  <div class="container">
    <div class="section-header">
      <span class="section-en">CLINIC INFO</span>
      <h2 class="section-title">医院情報</h2>
    </div>
    <table class="info-table">
      <tr><th>医院名</th><td>和地たなか歯科</td></tr>
      <tr><th>住所</th><td>〒470-0374 愛知県豊田市和地町宿3-2</td></tr>
      <tr><th>電話</th><td>0565-25-xxxx</td></tr>
      <tr><th>診療科目</th><td>歯科・小児歯科・矯正歯科</td></tr>
    </table>
  </div>
</section>
<style>
.clinic-info { padding: 80px 0; background: #fff; }
.section-header { text-align: center; margin-bottom: 40px; }
.section-en { display: block; font-size: 13px; letter-spacing: 0.2em; color: var(--color-primary); font-weight: 600; margin-bottom: 8px; }
.section-title { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 700; color: #1a1a1a; }
.info-table { width: 100%; max-width: 700px; margin: 0 auto; border-collapse: collapse; }
.info-table th, .info-table td { padding: 14px 20px; border: 1px solid #ddd; font-size: 0.95rem; }
.info-table th { background: #f0f7f4; color: var(--color-primary); font-weight: 600; width: 30%; text-align: left; }
</style>
