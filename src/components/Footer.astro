<footer class="footer">
  <div class="footer__main">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <a href="/" class="footer__logo-link" aria-label="和地たなか歯科 トップへ">
            <img
              src="https://storage.googleapis.com/studio-design-asset-files/projects/Kwa5x4ogqX/s-400x150_webp_fd667224-34af-4ea1-b45f-3dec542364fb.webp"
              alt="和地たなか歯科"
              width="180"
              height="68"
              class="footer__logo-img"
            />
          </a>
          <address class="footer__address">
            〒431-1115 静岡県浜松市和地町4757-1<br />
            <a href="tel:053-489-8185" class="footer__tel">tel. 053-489-8185</a>
          </address>
        </div>
        <div class="footer__hours">
          <table class="footer__hours-table" aria-label="診療時間">
            <thead>
              <tr>
                <th></th><th>月</th><th>火</th><th>水</th><th>木</th><th>金</th><th>土</th><th>日</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>8:45-13:30</th>
                <td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td></td>
              </tr>
              <tr>
                <th>13:30-16:30</th>
                <td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td><span class="dot"></span></td><td></td><td></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <nav class="footer__nav" aria-label="フッターナビゲーション">
        <ul class="footer__nav-list">
          <li><a href="/">ホーム</a></li>
          <li><a href="/#features">当院の特長</a></li>
          <li><a href="/#treatments">診療案内</a></li>
          <li><a href="/#access">アクセス</a></li>
          <li><a href="/reviews">患者さんの声</a></li>
          <li><a href="/recruit">求人</a></li>
        </ul>
      </nav>
      <div class="footer__actions">
        <a href="https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae" class="footer__reserve-btn" target="_blank" rel="noopener noreferrer">診療予約</a>
      </div>
    </div>
  </div>
  <div class="footer__copy-bar">
    <p class="footer__copy">Copyright &copy;和地たなか歯科 All right reserved.</p>
  </div>
</footer>
<style>
  .footer { background-color: var(--color-primary, #018966); color: rgba(255,255,255,0.9); }
  .footer__main { padding-block: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.15); }
  .footer__grid { display: flex; flex-direction: column; gap: 2rem; }
  @media (min-width: 768px) { .footer__grid { flex-direction: row; align-items: flex-start; gap: 3rem; } }
  .footer__brand { flex-shrink: 0; }
  .footer__logo-link { display: inline-block; margin-bottom: 1rem; }
  .footer__logo-img { height: 52px; width: auto; filter: brightness(0) invert(1); }
  .footer__address { font-style: normal; font-size: 0.82rem; color: rgba(255,255,255,0.8); line-height: 1.8; }
  .footer__tel { color: rgba(255,255,255,0.9); font-weight: 500; }
  .footer__hours { flex: 1; }
  .footer__hours-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; color: rgba(255,255,255,0.85); margin-bottom: 0.75rem; }
  .footer__hours-table thead th { padding: 0.4rem 0.5rem; text-align: center; font-weight: 400; color: rgba(255,255,255,0.6); border-bottom: 1px solid rgba(255,255,255,0.2); }
  .footer__hours-table thead th:first-child { text-align: left; }
  .footer__hours-table tbody th { padding: 0.4rem 0.5rem 0.4rem 0; text-align: left; font-weight: 400; color: rgba(255,255,255,0.7); white-space: nowrap; }
  .footer__hours-table tbody td { text-align: center; padding: 0.4rem 0.5rem; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: #fff; }
  .footer__bottom { padding-block: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.15); }
  .footer__bottom-inner { display: flex; flex-direction: column; gap: 1rem; }
  @media (min-width: 768px) { .footer__bottom-inner { flex-direction: row; align-items: center; justify-content: space-between; } }
  .footer__nav-list { display: flex; flex-wrap: wrap; }
  .footer__nav-list li a { display: inline-block; font-size: 0.78rem; color: rgba(255,255,255,0.75); padding: 0.2rem 0.75rem; border-right: 1px solid rgba(255,255,255,0.25); transition: color 0.2s; }
  .footer__nav-list li:last-child a { border-right: none; }
  .footer__nav-list li a:hover { color: #fff; }
  .footer__actions { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
  .footer__reserve-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.6rem 1.5rem; background-color: #fff; color: var(--color-primary, #018966); font-size: 0.85rem; font-weight: 700; border-radius: 4px; white-space: nowrap; }
  .footer__reserve-btn:hover { background-color: rgba(255,255,255,0.85); }
  .footer__copy-bar { padding-block: 0.875rem; text-align: center; }
  .footer__copy { font-size: 0.72rem; color: rgba(255,255,255,0.5); }
</style>
