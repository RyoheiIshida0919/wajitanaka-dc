---
const reserveUrl = 'https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae';
const navColumns = [
  [
    { label: 'ホーム', href: '/' },
    { label: '当院の特徴', href: '/#features' },
    { label: '診療案内', href: '/#treatments' },
  ],
  [
    { label: '医師紹介', href: '/doctors' },
    { label: 'アクセス', href: '/#access' },
    { label: 'ブログ', href: '/blog' },
  ],
  [
    { label: 'こだわりとQ&A', href: '/reviews' },
    { label: '求人', href: '/recruit' },
    { label: 'プライバシーポリシー', href: '/privacy-policy' },
  ],
];
---

<footer class="footer">
  <div class="container footer__upper">
    <div class="footer__brand">
      <img src="/images/site/logo.png" alt="和地たなか歯科" width="342" height="149" />
      <address>
        〒431-1115<br />
        静岡県浜松市中央区和地町4757-1<br />
        <a href="tel:053-489-8185">tel. 053-489-8185</a>
      </address>
    </div>

    <div class="footer__hours">
      <table aria-label="診療時間">
        <thead>
          <tr><th>診療時間</th><th>月</th><th>火</th><th>水</th><th>木</th><th>金</th><th>土</th><th>日</th></tr>
        </thead>
        <tbody>
          <tr>
            <th>8:45-13:30</th>
            <td>●</td><td>●</td><td>●</td><td>●</td><td>●</td><td>●</td><td>ー</td>
          </tr>
          <tr>
            <th>13:30-16:30</th>
            <td>●</td><td>●</td><td>●</td><td>●</td><td>●</td><td>ー</td><td>ー</td>
          </tr>
        </tbody>
      </table>
      <p>患者さんのご都合に合わせた診療時間で、平日・土曜日も通院いただけます。</p>
    </div>
  </div>

  <div class="container footer__lower">
    <nav class="footer__nav" aria-label="フッターナビゲーション">
      {navColumns.map((column) => (
        <ul>{column.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      ))}
    </nav>
    <div class="footer__actions">
      <a class="footer__instagram" href="https://www.instagram.com/wajitanakadc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <span aria-hidden="true">◎</span> Instagram
      </a>
      <a class="reserve-link reserve-link--white" href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
    </div>
  </div>

  <div class="footer__copyright">
    <div class="container">Copyright &copy; 和地たなか歯科 All rights reserved.</div>
  </div>
</footer>

<style>
  .footer {
    background: var(--green);
    color: #fff;
  }

  .footer__upper {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(520px, 1.25fr);
    gap: clamp(60px, 10vw, 150px);
    padding-block: 70px 52px;
  }

  .footer__brand img {
    width: 214px;
    margin-bottom: 20px;
    filter: brightness(0) invert(1);
  }

  .footer__brand address {
    font-size: 0.78rem;
    font-style: normal;
    line-height: 2;
    letter-spacing: 0.08em;
  }

  .footer__brand address a {
    display: inline-block;
    margin-top: 5px;
    font-size: 1.05rem;
  }

  .footer__hours table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .footer__hours th,
  .footer__hours td {
    padding: 10px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.42);
    font-weight: 400;
    text-align: center;
  }

  .footer__hours th:first-child {
    min-width: 115px;
    text-align: left;
  }

  .footer__hours tbody td {
    font-size: 0.65rem;
  }

  .footer__hours p {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.72rem;
  }

  .footer__lower {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: end;
    padding-block: 46px 60px;
    border-top: 1px solid rgba(255, 255, 255, 0.34);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(130px, 1fr));
    gap: 32px;
    max-width: 700px;
  }

  .footer__nav li + li {
    margin-top: 11px;
  }

  .footer__nav a {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .footer__nav a::before {
    margin-right: 0.7rem;
    content: '—';
    opacity: 0.72;
  }

  .footer__actions {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .footer__instagram {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
  }

  .footer__instagram span {
    font-size: 1.45rem;
  }

  .footer__copyright {
    padding-block: 17px;
    background: #fff;
    color: #777;
    font-family: var(--font-number);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-align: center;
  }

  @media (max-width: 900px) {
    .footer__upper {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .footer__lower {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 600px) {
    .footer__upper {
      padding-block: 54px 42px;
    }

    .footer__hours {
      overflow-x: auto;
    }

    .footer__hours table {
      min-width: 560px;
    }

    .footer__nav {
      grid-template-columns: 1fr 1fr;
      gap: 28px 18px;
    }

    .footer__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .footer__actions .reserve-link {
      width: 100%;
    }
  }
</style>
