---
const reserveUrl = 'https://planetdentale.com/reserve/about.php?web_code=24da7c41f707a2b72d5ac93333b5fd819538b22b405ac3c5f874c15400a2c0ae';
const navColumns = [
  [
    { label: 'ホーム', href: '/' },
    { label: '当院の特長', href: '/#features' },
  ],
  [
    { label: '診療案内', href: '/#treatments' },
    { label: '医師紹介', href: '/doctors' },
  ],
  [
    { label: 'アクセス', href: '/#access' },
    { label: '求人', href: '/recruit' },
  ],
  [
    { label: '患者さんの声', href: '/reviews' },
    { label: 'ブログ（症例紹介）', href: '/blog' },
  ],
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__info">
        <div class="footer__logo">
          <img src="/images/site/logo-mark.png" alt="" width="87" height="83" aria-hidden="true" />
          <span class="footer__logo-text" aria-label="和地たなか歯科 waji tanaka dental clinic">
            <span class="footer__logo-ja">和地たなか歯科</span>
            <span class="footer__logo-en">waji tanaka dental clinic</span>
          </span>
        </div>
        <p>〒431-1115 静岡県浜松市中央区和地町4757-1</p>
        <p class="footer__tel"><a href="tel:053-489-8185">tel. 053-489-8185</a></p>
      </div>

      <div class="footer__hours-area">
        <table class="footer__hours" aria-label="診療時間">
          <thead>
            <tr>
              <th></th>
              <th>月</th><th>火</th><th>水</th><th>木</th><th>金</th><th>土</th><th>日</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>8:45-13:30</td>
              <td>●</td><td>●</td><td>●</td><td>●</td><td>●</td><td>●</td><td></td>
            </tr>
            <tr>
              <td>13:30-16:30</td>
              <td>●</td><td>●</td><td>●</td><td>●</td><td>●</td><td></td><td></td>
            </tr>
          </tbody>
        </table>

        <a class="footer__notice" href="/privacy-policy">患者様へのご案内（保険医療機関における書面掲示）</a>
      </div>
    </div>

    <div class="footer__line"></div>

    <div class="footer__nav-area">
      <nav class="footer__nav" aria-label="フッターナビゲーション">
        {navColumns.map((column) => (
          <ul>{column.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        ))}
      </nav>

      <a class="footer__instagram" href="https://www.instagram.com/wajitanakadc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.25" cy="6.75" r="1" />
        </svg>
      </a>

      <a class="footer__reserve" href={reserveUrl} target="_blank" rel="noopener noreferrer">診療予約</a>
    </div>

    <p class="footer__copyright">Copyright &copy;和地たなか歯科 All right reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: #008f6b;
    color: #fff;
    font-family: "Noto Sans JP", "Yu Gothic", "YuGothic", "Hiragino Kaku Gothic ProN", sans-serif;
  }

  .footer__inner {
    width: min(836px, calc(100% - 88px));
    margin: 0 auto;
    padding: 28px 0 15px;
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 326px;
    align-items: start;
    gap: 74px;
  }

  .footer__info {
    min-width: 0;
  }

  .footer__logo {
    display: flex;
    width: 282px;
    height: 50px;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .footer__logo img {
    display: block;
    width: 42px;
    max-width: none;
    height: auto;
    margin-top: 5px;
    margin-right: 5px;
    flex: 0 0 auto;
    filter: brightness(0) invert(1);
  }

  .footer__logo-text {
    display: block;
    min-width: 0;
    color: #fff;
    white-space: nowrap;
  }

  .footer__logo-ja {
    display: block;
    font-family: "Zen Maru Gothic", "Noto Sans JP", sans-serif;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 0.98;
  }

  .footer__logo-en {
    display: block;
    margin-top: 1px;
    padding-left: 24px;
    font-family: "Rubik", "Noto Sans JP", sans-serif;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.38em;
    line-height: 1;
  }

  .footer__info p {
    margin: 0 0 2px 5px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .footer__tel {
    margin-top: 3px;
  }

  .footer__hours-area {
    width: 326px;
    padding-top: 11px;
    transform: translateX(-34px);
  }

  .footer__hours {
    width: 100%;
    border-collapse: collapse;
    color: #fff;
    font-size: 12px;
    text-align: center;
  }

  .footer__hours th,
  .footer__hours td {
    height: 24px;
    border: 1px solid rgba(255, 255, 255, 0.68);
    font-weight: 400;
    line-height: 1;
  }

  .footer__hours th:first-child,
  .footer__hours td:first-child {
    width: 82px;
    padding-right: 10px;
    border-left: none;
    text-align: right;
  }

  .footer__hours th {
    font-size: 12px;
  }

  .footer__hours th:last-child,
  .footer__hours td:last-child {
    border-right: none;
  }

  .footer__hours tr:first-child th {
    border-top: 1px solid rgba(255, 255, 255, 0.68);
  }

  .footer__hours tr:last-child td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.68);
  }

  .footer__hours td:not(:first-child) {
    font-size: 17px;
    line-height: 1;
  }

  .footer__notice {
    display: block;
    margin-top: 12px;
    color: #fff;
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
    text-decoration: underline;
  }

  .footer__line {
    height: 1px;
    margin: 22px 26px 14px 12px;
    background: rgba(255, 255, 255, 0.78);
  }

  .footer__nav-area {
    display: flex;
    align-items: flex-start;
    padding: 0 26px 0 18px;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: 92px 104px 76px 128px;
    column-gap: 34px;
  }

  .footer__nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__nav li {
    margin-bottom: 2px;
  }

  .footer__nav a {
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.55;
    text-decoration: none;
  }

  .footer__instagram {
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    margin-left: 6px;
    color: #fff;
    text-decoration: none;
  }

  .footer__instagram svg {
    width: 36px;
    height: 36px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
  }

  .footer__reserve {
    display: flex;
    width: 90px;
    height: 49px;
    align-items: center;
    justify-content: center;
    margin-top: -1px;
    margin-left: auto;
    background: #fff;
    border-radius: 3px;
    color: #008f6b;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .footer__copyright {
    margin: 28px 0 0;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
    letter-spacing: 0;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .footer__inner {
      width: min(100% - 40px, 620px);
      padding: 32px 0 24px;
    }

    .footer__top,
    .footer__nav-area {
      display: block;
    }

    .footer__hours-area {
      width: 100%;
      padding-top: 24px;
    }

    .footer__logo {
      margin-inline: auto;
    }

    .footer__info p {
      margin-left: 0;
      text-align: center;
    }

    .footer__nav {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .footer__instagram {
      display: inline-block;
      margin-top: 24px;
      margin-left: 0;
    }

    .footer__reserve {
      margin: 32px 0 0;
    }
  }

  @media (max-width: 600px) {
    .footer__inner {
      width: min(100% - 32px, 560px);
      padding: 32px 0 24px;
    }

    .footer__hours-area {
      overflow-x: auto;
    }

    .footer__hours {
      min-width: 560px;
    }

    .footer__nav {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .footer__reserve {
      width: 100%;
      height: 52px;
    }
  }
</style>
